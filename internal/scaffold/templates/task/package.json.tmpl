{
  "name": "{{.Task.Slug}}-task",
  "version": "1.0.0",
  "description": "{{j .Task.Description}}",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "jest",
    "testdev": "jest --watch",
    "coverage": "jest --coverage",
    "build": "tsc -p tsconfig.build.json",
    "test-local": "export $(grep -v '^#' .env | xargs -0); bun src/{{.Task.Entry}}.ts",
    "clean": "node -e \"require('fs').rmSync('../../../tasks/{{.Task.Slug}}',{recursive:true,force:true})\"",
    "configure": "node -e \"for (const f of ['task.json','icon.png']) require('fs').copyFileSync(f,'../../../tasks/{{.Task.Slug}}/'+f)\"",
    "package": "npm run clean && ncc build src/{{.Task.Entry}}.ts -o ../../../tasks/{{.Task.Slug}} --minify && npm run configure"
  },
  "author": "{{j .Project.Author}}",
  "license": "{{.Project.LicenseID}}",
  "dependencies": {
    "azure-pipelines-task-lib": "^5.2.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.10.0",
    "@vercel/ncc": "^0.38.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.2"
  }
}
